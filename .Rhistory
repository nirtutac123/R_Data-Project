pivot_longer(
cols = c(data1, data2, data3),
names_to = "data_name",
values_to = "data_values"
)
View(dummy_data)
is.na(long_data$data_values)
sum(
is.na(long_data$data_values)
)
long_data <- long_data |> na.omit()
sum(
is.na(long_data$data_values)
)
dummy_data %>%
filter(!complete.cases(.))
two_data <- long_data |>
filter(data_name %in% c("data1", "data2"))
t_result <- t_test(
data = two_data,
formula = data_values ~ data_name
)
t_result
